# Required for the narrative brief (Groq). Without it the app still computes
# and displays real base rates, with an explicit "no brief" note.
GROQ_API_KEY=
# Optional — overrides the default model qwen/qwen3.8-27b
GROQ_MODEL=
# Optional — recent headlines. Headlines are omitted (not faked) without it.
NEWSAPI_KEY=
# No market-data key is required: equities come from Yahoo Finance and crypto
# from Coinbase Exchange, both keyless. ALPHA_VANTAGE_API_KEY is not used.
PORT=3000